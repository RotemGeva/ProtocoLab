<UserControl x:Class="ProtocoLab.SelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProtocoLab" d:DataContext="{d:DesignInstance Type=local:SelectionDialogViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Title}" FontSize="18" Margin="10"/>

    <ListView Grid.Row="1" 
                  ItemsSource="{Binding Protocols}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <CheckBox Content="{Binding Name}" 
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
      <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,10,0"/>
      <Button Content="Confirm" Command="{Binding ConfirmCommand}" Margin="0,0,10,0"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
    </StackPanel>
  </Grid>
</UserControl>
